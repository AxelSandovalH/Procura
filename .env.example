# Copia a .env.local y rellena. .env.local está en .gitignore.

# --- Supabase (dashboard → Project Settings → API / Database) ---
NEXT_PUBLIC_SUPABASE_URL=https://bmbfheansyswcjnwgbqr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # solo servidor: Inngest, jobs cross-org. Nunca al cliente.

# Conexión del backend (usuario procura_app, RLS activo). Pooler transaction mode, puerto 6543.
DATABASE_URL=postgresql://procura_app:<password>@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true
# Conexión directa (migraciones / prisma migrate). Puerto 5432.
DIRECT_URL=postgresql://postgres.bmbfheansyswcjnwgbqr:<password>@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# Usada por `supabase db push` (contraseña del usuario postgres del proyecto)
SUPABASE_DB_PASSWORD=

# --- Inngest ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Email transaccional ---
RESEND_API_KEY=
EMAIL_FROM=Procura <no-reply@procura.app>

# --- App ---
APP_URL=http://localhost:3000
